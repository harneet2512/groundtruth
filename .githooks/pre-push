#!/bin/sh
set -eu

remote_name=${1:-origin}
remote_url=${2:-}
zero=0000000000000000000000000000000000000000
trace=${GT_FIXTURE_FIRST_TRACE:-0}
stdin_file=$(mktemp)
temp_dirs=
cleanup() {
  rm -f "$stdin_file"
  for dir in $temp_dirs; do
    case "$dir" in /tmp/*) rm -rf -- "$dir" ;; esac
  done
}
trap cleanup EXIT HUP INT TERM
cat >"$stdin_file"

say_trace() {
  if [ "$trace" = 1 ]; then
    printf '%s\n' "$*"
  fi
}

is_protected_path() {
  path=$1
  case "$path" in
    *_test.go|README.md|docs/*|.githooks/tests/*|.githooks/red-artifacts/*)
      return 1
      ;;
    .githooks/pre-push|gt-index/internal/resolver/*.go|gt-index/internal/store/incremental.go|gt-index/internal/store/resolution_contract.go|gt-index/internal/store/resolution_v2.go|gt-index/internal/store/sqlite.go|gt-index/cmd/gt-index/build_info.go|gt-index/cmd/gt-index/main.go|gt-index/cmd/gt-index/publication.go|gt-index/cmd/gt-index/publication_*.go)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

commit_has_protected_change() {
  commit=$1
  git diff-tree --root --no-commit-id --name-only -r "$commit" | while IFS= read -r path; do
    if is_protected_path "$path"; then
      printf '%s\n' "$path"
    fi
  done | grep . >/dev/null
}

history_has_protected_change() {
  root=$1
  local_sha=$2
  commit_has_protected_change "$root" || range_has_protected_change "$root" "$local_sha"
}

range_has_protected_change() {
  base=$1
  local_sha=$2
  for commit in $(git rev-list --reverse "$base..$local_sha"); do
    if commit_has_protected_change "$commit"; then
      return 0
    fi
  done
  return 1
}

nearest_remote_ancestor() {
  local_sha=$1
  candidates=$(mktemp)
  for ref in $(git for-each-ref --format='%(refname)' "refs/remotes/$remote_name"); do
    case "$ref" in
      "refs/remotes/$remote_name/HEAD") continue ;;
    esac
    sha=$(git rev-parse "$ref^{commit}" 2>/dev/null || true)
    if [ -n "$sha" ] && git merge-base --is-ancestor "$sha" "$local_sha"; then
      distance=$(git rev-list --count "$sha..$local_sha")
      printf '%012d\t%s\t%s\n' "$distance" "$ref" "$sha" >>"$candidates"
    fi
  done
  if [ -s "$candidates" ]; then
    sort -k1,1n -k2,2 "$candidates" | head -n 1 | awk -F '\t' '{print $3}'
  fi
  rm -f "$candidates"
}

fixture_files_are_dedicated() {
  fixture_commit=$1
  found=0
  for path in $(git diff-tree --no-commit-id --name-only -r "$fixture_commit"); do
    found=1
    case "$path" in
      *_test.go|.githooks/tests/*|.githooks/red-artifacts/*) ;;
      *) return 1 ;;
    esac
  done
  [ "$found" -eq 1 ]
}

receipt_value() {
  key=$1
  file=$2
  sed -n "s/^${key}=//p" "$file"
}

safe_fixture_path() {
  case "$1" in
    .githooks/tests/*.sh) ;;
    *) return 1 ;;
  esac
  case "$1" in *[!A-Za-z0-9._/-]*) return 1 ;; esac
  case "/$1/" in */../*|*/./*|*\\*|*//* ) return 1 ;; esac
}

safe_output_path() {
  case "$1" in
    .githooks/red-artifacts/*.out) ;;
    *) return 1 ;;
  esac
  case "$1" in *[!A-Za-z0-9._/-]*) return 1 ;; esac
  case "/$1/" in */../*|*/./*|*\\*|*//* ) return 1 ;; esac
}

regular_blob_at() {
  commit=$1
  path=$2
  mode=$(git ls-tree "$commit" -- "$path" | awk 'NR == 1 {print $1}')
  [ "$mode" = 100644 ] || [ "$mode" = 100755 ]
}

execute_fixture() {
  fixture_commit=$1
  fixture_path=$2
  expected_exit=$3
  output_path=$4
  expected_hash=$5
  local_git_env=$(git rev-parse --local-env-vars)

  checkout_root=$(mktemp -d)
  temp_dirs="$temp_dirs $checkout_root"
  repo_root=$(git rev-parse --show-toplevel)
  mkdir "$checkout_root/repo" "$checkout_root/disabled-hooks"
  if ! (for name in $local_git_env; do unset "$name"; done; git -C "$checkout_root/repo" init -q); then
    say_trace "red_fixture_rejected=checkout_init_failed"
    return 1
  fi
  (for name in $local_git_env; do unset "$name"; done; git -C "$checkout_root/repo" config core.hooksPath "$checkout_root/disabled-hooks")
  (for name in $local_git_env; do unset "$name"; done; git -C "$checkout_root/repo" config core.autocrlf false)
  if ! (for name in $local_git_env; do unset "$name"; done; GIT_LFS_SKIP_SMUDGE=1 git -C "$checkout_root/repo" fetch -q --no-tags "$repo_root" "$fixture_commit"); then
    say_trace "red_fixture_rejected=checkout_fetch_failed"
    return 1
  fi
  if ! (for name in $local_git_env; do unset "$name"; done; GIT_LFS_SKIP_SMUDGE=1 git -C "$checkout_root/repo" checkout -q --detach FETCH_HEAD); then
    say_trace "red_fixture_rejected=checkout_materialization_failed"
    return 1
  fi
  [ -f "$checkout_root/repo/$fixture_path" ] || {
    say_trace "red_fixture_rejected=fixture_not_regular"
    return 1
  }
  [ -f "$checkout_root/repo/$output_path" ] || {
    say_trace "red_fixture_rejected=output_not_regular"
    return 1
  }

  actual_output="$checkout_root/actual.out"
  set +e
  (
    for name in $local_git_env; do unset "$name"; done
    cd "$checkout_root/repo"
    sh "./$fixture_path"
  ) >"$actual_output" 2>&1
  actual_exit=$?
  set -e
  if [ "$actual_exit" -eq 0 ] || [ "$actual_exit" -ne "$expected_exit" ]; then
    say_trace "red_fixture_rejected=exit_mismatch expected=$expected_exit actual=$actual_exit"
    return 1
  fi
  actual_hash=$(sha256sum "$actual_output" | awk '{print $1}')
  if [ "$actual_hash" != "$expected_hash" ]; then
    say_trace "red_fixture_rejected=output_hash_mismatch expected=$expected_hash actual=$actual_hash"
    return 1
  fi
  if ! cmp -s "$actual_output" "$checkout_root/repo/$output_path"; then
    say_trace "red_fixture_rejected=output_bytes_mismatch"
    return 1
  fi
}

validate_red_receipt() {
  fixture_commit=$1
  protected_commit=$2
  fixture_parent=$(git rev-parse "$fixture_commit^")
  subject=$(git log -1 --format=%s "$fixture_commit")
  case "$subject" in
    test\(red\):*) ;;
    *) return 1 ;;
  esac
  fixture_files_are_dedicated "$fixture_commit" || return 1

  receipts=$(git diff-tree --no-commit-id --name-only -r "$fixture_commit" | grep '^.githooks/red-artifacts/.*\.receipt$' || true)
  [ -n "$receipts" ] || return 1
  for receipt in $receipts; do
    receipt_file=$(mktemp)
    if ! git show "$fixture_commit:$receipt" >"$receipt_file" 2>/dev/null; then
      rm -f "$receipt_file"
      continue
    fi
    format=$(receipt_value format "$receipt_file")
    base_sha=$(receipt_value base_sha "$receipt_file")
    fixture_path=$(receipt_value fixture_path "$receipt_file")
    fixture_sha256=$(receipt_value fixture_sha256 "$receipt_file")
    command_value=$(receipt_value command "$receipt_file")
    exit_code=$(receipt_value exit_code "$receipt_file")
    output_path=$(receipt_value output_path "$receipt_file")
    output_sha256=$(receipt_value output_sha256 "$receipt_file")
    rm -f "$receipt_file"

    [ "$format" = gt.fixture-red.v1 ] || continue
    [ "$base_sha" = "$fixture_parent" ] || continue
    [ -n "$fixture_path" ] && [ -n "$command_value" ] && [ -n "$output_path" ] || continue
    case "$exit_code" in
      ''|*[!0-9]*|0) continue ;;
    esac
    printf '%s\n' "$fixture_sha256" | grep -Eq '^[0-9a-f]{64}$' || continue
    printf '%s\n' "$output_sha256" | grep -Eq '^[0-9a-f]{64}$' || continue
    safe_fixture_path "$fixture_path" || continue
    safe_output_path "$output_path" || continue
    case "$command_value" in
      "$fixture_path"|"C:\\Program Files\\Git\\bin\\sh.exe $fixture_path") ;;
      *) continue ;;
    esac
    changed=$(git diff-tree --no-commit-id --name-only -r "$fixture_commit")
    printf '%s\n' "$changed" | grep -Fx "$fixture_path" >/dev/null || continue
    printf '%s\n' "$changed" | grep -Fx "$output_path" >/dev/null || continue
    git cat-file -e "$fixture_commit:$fixture_path" 2>/dev/null || continue
    git cat-file -e "$fixture_commit:$output_path" 2>/dev/null || continue
    regular_blob_at "$fixture_commit" "$fixture_path" || continue
    regular_blob_at "$fixture_commit" "$output_path" || continue
    actual_fixture_hash=$(git show "$fixture_commit:$fixture_path" | sha256sum | awk '{print $1}')
    actual_hash=$(git show "$fixture_commit:$output_path" | sha256sum | awk '{print $1}')
    [ "$actual_fixture_hash" = "$fixture_sha256" ] || continue
    [ "$actual_hash" = "$output_sha256" ] || continue
    [ -n "$(git show "$fixture_commit:$output_path")" ] || continue
    execute_fixture "$fixture_commit" "$fixture_path" "$exit_code" "$output_path" "$output_sha256" || continue
    say_trace "red_fixture=$fixture_commit protected_commit=$protected_commit receipt=$receipt"
    return 0
  done
  return 1
}

check_range() {
  base=$1
  local_sha=$2
  for commit in $(git rev-list --reverse "$base..$local_sha"); do
    if ! commit_has_protected_change "$commit"; then
      continue
    fi
    fixture_commit=$(git rev-parse "$commit^")
    if ! validate_red_receipt "$fixture_commit" "$commit"; then
      if git log -1 --format=%s "$fixture_commit" | grep '^test(red):' >/dev/null 2>&1; then
        printf 'fixture-first pre-push: malformed RED receipt before protected commit %s\n' "$commit" >&2
      else
        printf 'fixture-first pre-push: missing preceding dedicated RED fixture commit before protected commit %s\n' "$commit" >&2
      fi
      return 1
    fi
  done
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue
  [ "$local_sha" != "$zero" ] || continue
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base=$remote_sha
    source=remote_sha
  else
    base=$(nearest_remote_ancestor "$local_sha")
    source=nearest_remote_ancestor
    if [ -z "$base" ]; then
      root=$(git rev-list --max-parents=0 "$local_sha" | sort | head -n 1)
      if history_has_protected_change "$root" "$local_sha"; then
        printf 'fixture-first pre-push: cannot determine protected new-branch range for %s\n' "$local_ref" >&2
        exit 1
      fi
      say_trace "range_base=$root range_source=unprotected_root_fallback local_ref=$local_ref"
      continue
    fi
  fi
  if ! git merge-base --is-ancestor "$base" "$local_sha"; then
    root=$(git rev-list --max-parents=0 "$local_sha" | sort | head -n 1)
    if history_has_protected_change "$root" "$local_sha"; then
      printf 'fixture-first pre-push: indeterminate protected range for %s\n' "$local_ref" >&2
      exit 1
    fi
    continue
  fi
  say_trace "range_base=$base range_source=$source local_ref=$local_ref"
  check_range "$base" "$local_sha"
done <"$stdin_file"

if [ "$trace" != 1 ]; then
  command -v git-lfs >/dev/null 2>&1 || {
    printf '%s\n' "fixture-first pre-push: git-lfs is required for the preserved LFS pre-push behavior" >&2
    exit 2
  }
  git lfs pre-push "$remote_name" "$remote_url" <"$stdin_file"
fi
